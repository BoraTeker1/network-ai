# Network AI — backend environment (example)
# Copy to .env and fill in as features land. Nothing here is required for v1 skeleton.

# SQLite database location (default used by app/db.py if unset)
DATABASE_URL=sqlite:///./network_ai.db

# Source for job ingestion (SimplifyJobs New-Grad-Positions README)
JOBS_README_URL=https://raw.githubusercontent.com/SimplifyJobs/New-Grad-Positions/dev/README.md

# ----- AI copilot (Claude primary, OpenAI fallback) -----
# When a key is set, outreach/email drafts are written by the model; otherwise
# the app falls back to deterministic templates. Keys are used by the backend
# only and are never logged or exposed. Claude (Anthropic) is the default
# provider; set ANTHROPIC_API_KEY to enable it.
LLM_PROVIDER=anthropic
ANTHROPIC_API_KEY=
# Defaults to the latest, most capable model. Override to trade cost/latency,
# e.g. claude-sonnet-4-6 or claude-haiku-4-5.
ANTHROPIC_MODEL=claude-opus-4-8

# Optional OpenAI fallback (Responses API only). Used only if no Anthropic key
# is set. Leave blank to keep it off.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini

# ----- Contact discovery providers (optional, compliant APIs only) -----
# Leave blank to keep automatic discovery OFF (manual contacts still work).
# No scraping is ever performed regardless of these values.
HUNTER_API_KEY=
PDL_API_KEY=

# ----- Event recommendation providers (optional, compliant APIs only) -----
# Powers GET /events/recommendations. With NO keys set, the feature still works
# by returning high-quality manual search links (Google/Eventbrite/Meetup/Luma)
# built from your strongest job match. No scraping is ever performed.
# Ticketmaster Discovery API: https://developer.ticketmaster.com
TICKETMASTER_API_KEY=
# Eventbrite/Meetup discovery needs per-user OAuth (not wired up yet) — leaving
# these blank simply keeps those providers on manual-search-link mode.
EVENTBRITE_API_TOKEN=
MEETUP_API_KEY=

# ----- Gmail sending (disabled by default) -----
# Sending stays OFF unless GMAIL_SEND_ENABLED=true AND OAuth is configured.
# This MVP prefers copy / manual send; no passwords are ever stored.
GMAIL_SEND_ENABLED=false
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
