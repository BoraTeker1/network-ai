# Network AI — backend environment (example)
# Copy to .env and fill in as features land. Nothing here is required for v1 skeleton.

# SQLite database location (default used by app/db.py if unset)
DATABASE_URL=sqlite:///./network_ai.db

# ----- AI copilot (Claude primary, OpenAI fallback) -----
# When a key is set, outreach/email drafts are written by the model; otherwise
# the app falls back to deterministic templates. Keys are used by the backend
# only and are never logged or exposed. Claude (Anthropic) is the default
# provider; set ANTHROPIC_API_KEY to enable it.
LLM_PROVIDER=anthropic
ANTHROPIC_API_KEY=
# Defaults to the latest, most capable model. Override to trade cost/latency,
# e.g. claude-sonnet-4-6 or claude-haiku-4-5.
ANTHROPIC_MODEL=claude-opus-4-8

# Optional OpenAI fallback (Responses API only). Used only if no Anthropic key
# is set. Leave blank to keep it off.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini

# ----- Contact discovery providers (optional, compliant APIs only) -----
# Leave blank to keep automatic discovery OFF (manual contacts still work).
# No scraping is ever performed regardless of these values.
HUNTER_API_KEY=
PDL_API_KEY=

# ----- Auth / sessions -----
# Sessions are opaque server-side tokens in HttpOnly cookies — no signing
# secret is needed. Set COOKIE_SECURE=true in production (HTTPS only).
COOKIE_SECURE=false
SESSION_TTL_DAYS=30

# ----- CORS / deployment -----
# Comma-separated list of allowed frontend origins. NEVER use a wildcard —
# credentialed CORS requires explicit origins.
ALLOWED_ORIGINS=http://localhost:3000
# Only honor X-Forwarded-For when running behind a proxy you control.
TRUST_PROXY=false

# ----- Billing (beta) -----
# Hosted checkout link (iyzico link / Lemon Squeezy / Stripe Payment Link).
# When set, "Upgrade to Pro" sends users to this URL; card data never touches
# the backend. Plans are still flipped manually via the audited admin action
# (POST /billing/set-plan) after the provider confirms payment. Leave blank to
# keep the honest fake-door message.
PAYMENT_LINK_URL=

# ----- Rate limiting (requests/minute; in-process, single-worker) -----
# RATE_LIMIT_DISABLED=1 turns rate limiting off (dev/tests only!).
# Per-action overrides (defaults in app/services/rate_limit.py):
# RATE_LIMIT_LOGIN=10
# RATE_LIMIT_SIGNUP=5
# RATE_LIMIT_OUTREACH_DRAFT=10
# RATE_LIMIT_NEXT_MOVE=10
# RATE_LIMIT_RESUME_UPLOAD=6
# RATE_LIMIT_OPPS_REFRESH=2
# RATE_LIMIT_EMAIL_DRAFT=10

# ----- Free-plan limits (per day unless noted; defaults in app/services/plans.py) -----
# PLAN_LIMIT_FREE_OUTREACH_DRAFT=5
# PLAN_LIMIT_FREE_NEXT_MOVE=5
# PLAN_LIMIT_FREE_EMAIL_DRAFT=10
# PLAN_LIMIT_FREE_RESUME_UPLOAD=10
# PLAN_LIMIT_FREE_PIPELINE_SAVE=15   # total pipeline items, not daily

# ----- Gmail sending (disabled by default) -----
# Sending stays OFF unless GMAIL_SEND_ENABLED=true AND OAuth is configured.
# This MVP prefers copy / manual send; no passwords are ever stored.
GMAIL_SEND_ENABLED=false
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
